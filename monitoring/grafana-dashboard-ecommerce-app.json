{
  "dashboard": {
    "id": null,
    "uid": "ecommerce-app",
    "title": "Ecommerce Application Performance",
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": { "from": "now-30m", "to": "now" },
    "panels": [
      {
        "id": 1, "title": "Backend Pod CPU Usage", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"ecommerce\",pod=~\"backend-.*\"}[5m])) by (pod)", "legendFormat": "{{pod}}" }]
      },
      {
        "id": 2, "title": "Backend Pod Memory Usage", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [{ "expr": "sum(container_memory_working_set_bytes{namespace=\"ecommerce\",pod=~\"backend-.*\"}) by (pod)", "legendFormat": "{{pod}}" }]
      },
      {
        "id": 3, "title": "Frontend Pod CPU Usage", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"ecommerce\",pod=~\"frontend-.*\"}[5m])) by (pod)", "legendFormat": "{{pod}}" }]
      },
      {
        "id": 4, "title": "Frontend Pod Memory Usage", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [{ "expr": "sum(container_memory_working_set_bytes{namespace=\"ecommerce\",pod=~\"frontend-.*\"}) by (pod)", "legendFormat": "{{pod}}" }]
      },
      {
        "id": 5, "title": "Ecommerce Pod Status", "type": "stat",
        "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [{ "expr": "sum(kube_pod_status_phase{namespace=\"ecommerce\",phase=\"Running\"})", "legendFormat": "Running pods" }]
      },
      {
        "id": 6, "title": "Ecommerce Pod Restarts (5m rate)", "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [{ "expr": "sum(rate(kube_pod_container_status_restarts_total{namespace=\"ecommerce\"}[5m])) by (pod)", "legendFormat": "{{pod}}" }]
      }
    ]
  },
  "overwrite": true,
  "folderId": 0
}

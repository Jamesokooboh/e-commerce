COMPOSE_PROJECT_NAME=ecommerce
FRONTEND_PORT=3000
BACKEND_PORT=5000
MONGO_PORT=27017
MONGO_DATABASE=ecommerce
FRONTEND_URL=http://localhost:3000
# Set this to your server's public URL (e.g. http://<ec2-public-ip>:5000) when
# accessing the app from a browser that isn't on the same host as Docker.
# Leave unset for local dev (defaults to http://localhost:5000).
PUBLIC_BACKEND_URL=
FRONTEND_IMAGE=abdelazez66/ecommerce-frontend:v1
BACKEND_IMAGE=abdelazez66/ecommerce-backend:v1
JWT_SECRET=replace-with-a-long-random-secret
